# Copy to .env for host scripts and `npm run start:dev`.
# docker-compose.yml sets its own values for the app container.
NODE_ENV=development
PORT=3000

# docker compose publishes Mongo on this host port (27018 avoids a clash with
# a local mongod on 27017); the two URIs below must use the same port.
MONGO_HOST_PORT=27018
MONGO_RAW_URI=mongodb://localhost:27018/provider_raw
MONGO_TARGET_URI=mongodb://localhost:27018/provider_target

REDIS_HOST=localhost
REDIS_PORT=6379

# Documents per job (range size) and cursor batch size
BATCH_SIZE=50
# Concurrent jobs per worker process
WORKER_CONCURRENCY=4

# Optional, not validated: debug (default) | info | warn | error
# LOG_LEVEL=debug
