# Copy to .env for running the app on the host (npm run start:dev).
# docker-compose.yml sets its own values for the app container.
NODE_ENV=development
PORT=3000

MONGO_RAW_URI=mongodb://localhost:27017/provider_raw
MONGO_TARGET_URI=mongodb://localhost:27017/provider_target

REDIS_HOST=localhost
REDIS_PORT=6379

# Documents read from the raw cursor per job
BATCH_SIZE=500
# Concurrent jobs per worker process
WORKER_CONCURRENCY=4
